# ── Firebase client SDK (safe to expose — NEXT_PUBLIC) ──────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=meek-earth-email-capture
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_ID=meek-earth-studio

# ── Google Analytics 4 ───────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Server-side (keep secret — store in GCP Secret Manager in prod) ──
# Path to a service account JSON, or leave unset to use Application
# Default Credentials on Firebase App Hosting / Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=

# GCS bucket holding stems, documentary video, and nonprofit toolkits
GCS_ASSETS_BUCKET=meek-earth-assets

# BigQuery
BIGQUERY_DATASET=meek_earth_analytics

# Rate limiting (optional) — when set, API rate limits are shared across
# all server instances via Upstash Redis (free tier at upstash.com).
# Unset = per-instance in-memory limiting, fine for launch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Third-party integrations
CONVERTKIT_API_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
